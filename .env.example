APP_NAME=Voice AI Patient Registration
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Easy local start (persistent SQLite):
DATABASE_URL=sqlite:///./voice_patient.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/voice_patient_db

VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-secret
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["*"]
